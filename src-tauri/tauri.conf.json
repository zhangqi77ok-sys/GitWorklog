{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeMind-Hub",
  "version": "1.0.0",
  "identifier": "com.codemind.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../prototype/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeMind-Hub",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
