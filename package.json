{
  "name": "gitworklog-loop-control-plane",
  "private": true,
  "version": "0.1.0",
  "description": "Loop engineering control plane for AI coding runs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace @gitworklog/web",
    "dev:desktop": "npm run dev --workspace @gitworklog/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
