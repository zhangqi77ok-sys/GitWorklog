# ============================================================
# 统一智能体平台 · 环境变量样例
# 复制为 .env 并填入真实值。.env 不入库（见 .gitignore）。
# 所有配置通过 app/core/config.py 的 pydantic-settings 加载。
# ============================================================

# ---- 应用 ----
APP_ENV=dev                       # dev / test / prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ---- 认证（JWT，替代 Sa-Token）----
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRE_MINUTES=43200     # 30 天

# ---- MySQL 主库（平台 + travel 域）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unified_agent
DB_USER=root
DB_PASSWORD=

# ---- data 域被查询业务库（独立只读连接，隔离）----
DATA_DB_HOST=127.0.0.1
DATA_DB_PORT=3306
DATA_DB_NAME=sakila
DATA_DB_USER=readonly
DATA_DB_PASSWORD=

# ---- Redis（会话/缓存/中断广播/熔断计数）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- PgVector（文件 RAG + 语义记忆）----
PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5432
PGVECTOR_DB=vectors
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=

# ---- MinIO（文件 + 图表）----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=unified-agent-files
MINIO_SECURE=false

# ---- 模型（按场景选择，可留空用默认）----
DASHSCOPE_API_KEY=                # 通义千问 / Embedding / 多模态
DEEPSEEK_API_KEY=                 # data 域主推理
LLM_STRONG_MODEL=qwen3.7-max
LLM_FAST_MODEL=qwen3.6-flash
LLM_EMBEDDING_MODEL=text-embedding-v4

# ---- MCP ----
MCP_ECHARTS_URL=http://127.0.0.1:3033/mcp
TAVILY_API_KEY=

# ---- 外部 API（travel 域）----
NEWS_API_KEY=
